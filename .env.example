# Server only. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Enable web search deliberately; provider quotas and charges vary.
ENABLE_WEB_SEARCH=false
# Optional server-only search key. When set, web search uses Tavily.
TAVILY_API_KEY=
# Protect the provider quota. Public guests get the local preview by default.
ALLOW_GUEST_AI=false
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
# Supabase project settings > API. These two values are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
